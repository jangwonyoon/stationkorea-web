{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && node scripts/indexnow.mjs",
  "redirects": [
    { "source": "/ig{/}?", "destination": "/?utm_source=instagram&utm_medium=profile", "permanent": false },
    { "source": "/c{/}?", "destination": "/?utm_source=community", "permanent": false }
  ],
  "headers": [
    {
      "source": "/station/:slug/article.md",
      "headers": [{ "key": "Link", "value": "<https://www.stationkorea.com/station/:slug/>; rel=\"canonical\"" }]
    },
    {
      "source": "/article/:slug/article.md",
      "headers": [{ "key": "Link", "value": "<https://www.stationkorea.com/article/:slug/>; rel=\"canonical\"" }]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
