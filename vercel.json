{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && node scripts/indexnow.mjs",
  "headers": [
    {
      "source": "/station/:slug/article.md",
      "headers": [{ "key": "Link", "value": "<https://www.stationkorea.com/station/:slug/>; rel=\"canonical\"" }]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
